# ---------------------------------------------------------------------------
# Luxury Objective — variáveis de ambiente
# Copia para `.env.local` e preenche. `.env.local` nunca entra no repositório.
# ---------------------------------------------------------------------------

# URL canónico do site. Usado em metadata, Open Graph, sitemap e JSON-LD.
# Local: http://localhost:3000 · Produção: https://www.luxuryobjective.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fecha o site aos motores de busca. Liga em QUALQUER ambiente que não seja o
# domínio definitivo — pré-visualizações, staging, deploys de aprovação.
NEXT_PUBLIC_NOINDEX=true

# --- Supabase --------------------------------------------------------------
# Sem estas duas, o site continua a arrancar e a compilar: os projetos vêm do
# conjunto local aprovado (lib/queries/fallback.ts) e o painel devolve 503.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. Ignora RLS — nunca a exponhas ao cliente nem a prefixes com
# NEXT_PUBLIC_. Usada pelas route handlers dos formulários e uploads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança -------------------------------------------------------------
# Sal do hash de IP usado no rate limiting. Qualquer string longa e aleatória.
RATE_LIMIT_SALT=

# --- Testes E2E do painel (opcional) ---------------------------------------
# Sem estas, os testes de CRUD do admin são saltados em vez de falharem.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- ImageKit (opcional) ---------------------------------------------------
# Só para o script `node scripts/imagekit-list.mjs`, que lista os ficheiros da
# conta para não ser preciso copiar URL a URL. Não é usada pelo site.
IMAGEKIT_PRIVATE_KEY=
