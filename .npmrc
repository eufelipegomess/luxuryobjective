# O projeto tem de viver em disco local. Se por alguma razão ficar numa pasta
# sincronizada (Google Drive, OneDrive), o sistema de ficheiros virtual rebenta
# com as escritas paralelas do npm (EBADF) — nesse caso acrescenta aqui:
#   maxsockets=1
# Fora isso não limitamos a concorrência: em CI tornaria o install muito lento.
audit=false
fund=false
